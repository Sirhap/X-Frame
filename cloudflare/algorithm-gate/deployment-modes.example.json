{
  "schemaVersion": 1,
  "defaultMode": "static",
  "modes": {
    "static": {
      "controlledDistribution": false,
      "artifactManifestUrl": "/asset-manifest.json",
      "protectionLimit": "Public versioned WASM remains downloadable; build isolation, stripping, hashing, watermarking, and audits still apply."
    },
    "controlled": {
      "controlledDistribution": true,
      "authorizationUrl": "https://REPLACE_WITH_AUTHORIZATION_WORKER_HOST/v1/session",
      "challengeAction": "algorithm-artifact-session",
      "challengeSiteKey": "REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY",
      "sessionRefreshSkewSeconds": 30
    }
  }
}
