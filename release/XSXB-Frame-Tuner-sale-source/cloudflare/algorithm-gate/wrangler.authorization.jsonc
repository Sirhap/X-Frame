{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xsxb-algorithm-authorization",
  "main": "authorization/src/index.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACTIVE_VERSIONS": "REPLACE_WITH_ACTIVE_VERSION",
    "ALLOWED_ORIGINS": "[\"http://localhost:3000\",\"http://127.0.0.1:3000\",\"https://REPLACE_WITH_PRODUCTION_HOST\"]",
    "ARTIFACT_BASE_URL": "https://REPLACE_WITH_ARTIFACT_WORKER_HOST",
    "REQUIRE_ENTITLEMENT": "false",
    "REVOKED_VERSIONS": "",
    "SESSION_TTL_SECONDS": "300",
    "TURNSTILE_ACTION": "algorithm-artifact-session",
  },
  "kv_namespaces": [
    {
      "binding": "GATE_STATE",
      "id": "REPLACE_WITH_GATE_STATE_NAMESPACE_ID",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET", "SESSION_SIGNING_KEY"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
