{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xsxb-frame-tuner",
  "main": "cloudflare/site/src/index.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "XSXB_ADMIN_SESSION_MINUTES": 240,
    "XSXB_ADMIN_USERNAME": "admin",
  },
  "assets": {
    "directory": "./cloudflare/site/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/workspace", "/tools/*"],
  },
  "routes": [
    {
      "pattern": "xsxb.example.com",
      "custom_domain": true,
    },
    {
      "pattern": "xsxb-fast.example.com/*",
      "zone_name": "example.com",
    },
    {
      "pattern": "xsxb-cname.example.com/*",
      "zone_name": "example.com",
    },
  ],
  "d1_databases": [
    {
      "binding": "LICENSE_DB",
      "database_name": "xsxb-frame-tuner-licenses",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/site/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
