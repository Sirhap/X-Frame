{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xsxb-frame-tuner",
  "main": "cloudflare/site/src/index.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "XSXB_ADMIN_SESSION_MINUTES": 240,
    "XSXB_ADMIN_USERNAME": "sirhao",
    "XSXB_EMAIL_FROM": "XSXB Frame Tuner <login@devops9527.dpdns.org>",
  },
  "assets": {
    "directory": "./cloudflare/site/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/admin.html", "/admin/*", "/api/*", "/workspace", "/tools/*"],
  },
  "routes": [
    {
      "pattern": "xframe.dpdns.org",
      "custom_domain": true,
    },
    {
      "pattern": "xsxb.devops9527.dpdns.org",
      "custom_domain": true,
    },
    {
      "pattern": "xsxb-fast.devops9527.dpdns.org/*",
      "zone_name": "devops9527.dpdns.org",
    },
    {
      "pattern": "xsxb-cname.devops9527.dpdns.org/*",
      "zone_name": "devops9527.dpdns.org",
    },
  ],
  "d1_databases": [
    {
      "binding": "LICENSE_DB",
      "database_name": "xsxb-frame-tuner-licenses",
      "database_id": "af8f262c-f7b4-457e-810e-8ad6e642062a",
      "migrations_dir": "cloudflare/site/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
